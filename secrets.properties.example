# ============================================
# example secrets file
# copy this to secrets.properties and fill in your own values
# ============================================

# openweathermap - https://openweathermap.org/api
openweather.api.key=your-openweather-api-key

# telegram - https://t.me/botfather
telegram.bot.token=your-telegram-bot-token
telegram.chat.id=your-telegram-chat-id

# yandex email - https://id.yandex.ru/security/app-passwords
yandex.username=your-yandex@yandex.ru
yandex.app.password=your-yandex-app-password
email.to=recipient@example.com